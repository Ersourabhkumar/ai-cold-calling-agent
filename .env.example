# Free local trial (no paid telephony, STT, TTS, or LLM usage)
APP_ENV=development
DATABASE_URL=postgresql+psycopg://coldcalling:coldcalling_dev_password@localhost:5432/cold_calling_db
REDIS_URL=redis://localhost:6379/0

CALLING_MODE=mock
CALL_PROVIDER=mock
STT_MODE=mock
TTS_MODE=mock
LLM_MODE=test

# Set false for the explicit /start workflow used by local tests.
AUTO_DISPATCH_CALLS=false
MAX_CALL_ATTEMPTS=3
RETRY_DELAY_MINUTES=30
CALLBACK_DELAY_MINUTES=1440

# Production-only values. Keep empty in a local trial and never commit .env.
PUBLIC_BASE_URL=http://localhost:8000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TELEPHONY_PROVIDER=plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=
OPENAI_API_KEY=
OPENAI_MODEL=

# Tabbly production provider (current default for live calls).
# Switch to this by setting TELEPHONY_PROVIDER=tabbly and CALLING_MODE=production.
TABBLY_API_KEY=
TABBLY_AGENT_ID=
TABBLY_PHONE_NUMBER=
# Optional: needed only for call-logs reconciliation (call-logs-v2/update-campaign).
TABBLY_ORGANIZATION_ID=
# Optional: send + so many minutes ahead so Tabbly's scheduler begins dialing
# (default 5; Tabbly only dials campaigns whose window starts in the future).
TABBLY_START_FUTURE_MINUTES=5
# Optional shared secret verified on /webhooks/tabbly/status requests.
TABBLY_WEBHOOK_SECRET=

# API authentication (optional in dev, strongly recommended in production).
# When set, requests to /api/* must include `X-API-Key: <value>`.
# Public /health* and /webhooks* endpoints stay open so providers can call them.
API_KEY=

# Rate limit for /api/* requests per client IP (default 120/minute).
RATE_LIMIT_PER_MINUTE=120
