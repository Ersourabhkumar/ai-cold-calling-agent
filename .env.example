# Free local trial (no paid telephony or live calls)
APP_ENV=development
DATABASE_URL=postgresql+psycopg://coldcalling:coldcalling_dev_password@localhost:5432/cold_calling_db
REDIS_URL=redis://localhost:6379/0

CALLING_MODE=mock
LLM_MODE=test

# Calling behaviour
AUTO_DISPATCH_CALLS=false
MAX_CALL_ATTEMPTS=3
RETRY_DELAY_MINUTES=30
CALLBACK_DELAY_MINUTES=1440

# Production telephony: Sarvam Voice Agent (Instant Outbound).
# Set CALLING_MODE=production and TELEPHONY_PROVIDER=sarvam for live calls.
TELEPHONY_PROVIDER=sarvam
PUBLIC_BASE_URL=http://localhost:8000

# Sarvam Voice Agents credentials (Settings -> API Key in the dashboard
# where the Voice Agent lives; org/workspace IDs from workspace settings).
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=

OPENAI_API_KEY=
OPENAI_MODEL=

# API authentication (optional in dev, strongly recommended in production).
# When set, requests to /api/* and /ui/api/* must include `X-API-Key: <value>`.
# Public /health* and /webhooks* endpoints stay open so providers can call them.
API_KEY=

# Rate limit for /api/* requests per client IP (default 120/minute).
RATE_LIMIT_PER_MINUTE=120

# CRM integration (optional, default keeps everything local).
# Set CRM_PROVIDER=webhook + CRM_WEBHOOK_URL to forward every completed call
# (lead, outcome, qualification) to any CRM with an incoming JSON webhook
# (Zoho / HubSpot / custom endpoint / Sheets webhook catcher).
CRM_PROVIDER=none
CRM_WEBHOOK_URL=
